// use prisma-next

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  books     Book[]
}

model Book {
  id        Int      @id @default(autoincrement())
  title     String
  titleKey  String
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  notes     Note[]
}

model Note {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  book      Book     @relation(fields: [bookId], references: [id])
  bookId    Int
}
